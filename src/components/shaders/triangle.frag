// 画正圆：uv 两方向都归一到 [0,1]，但画布是 800×494.4（非正方形），
// 直接 length(vUv-0.5) 的"1"横向是 800px、纵向只有 494.4px → 圆被拉成椭圆。
// 解法：把宽方向 s 的名义坐标放大，使两个方向的单位长度一致。
// 练习约定：本文件统一使用 stpq 这一组 swizzle（.s ≡ .x ≡ .r，同一分量三套名字）

uniform float u_time;
varying vec2 vUv;

void main() {
  // 居中：c.s ∈ [-0.5, 0.5]（宽 800px）、c.t ∈ [-0.5, 0.5]（高 494.4px）
  vec2 c = vUv - vec2(0.5);

  // 宽高比修正：s 是"宽的那根轴"，名义坐标 ÷ 0.618（= ×1.618）放大，
  // 迫使横向提前触到阈值，与纵向物理尺度对齐 → 椭圆变圆
  // 修正后 |c.s| 最大 0.809、|c.t| 最大 0.5 → 可见圆半径上限 0.5
  c.s = c.s / 0.618;

  float d = length(c); // 到圆心的真实距离

  // 红底黑洞版：step(半径随机, d) 圆外=1（红底）、圆内=0（黑洞）
  // GLSL 无随机函数，惯用 hash：sin 大数取小数——确定性伪随机（同帧内每个像素拿到同一次采样）
  float rand = fract(sin(12.9898 * u_time) * 43758.5453); // u_time 驱动：每秒换一个新半径
  float r = mix(0.15, 0.45, rand); // 半径在 0.15~0.45 间随机（0.45 是修正后可见上限）
  float mask = step(r, d);
  // 抗锯齿版（洞边缘羽化 0.02）：
  // float mask = smoothstep(r - 0.01, r + 0.01, d);

  gl_FragColor = vec4(mask, 0.0, 0.0, 1.0);
}


